nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("-profile test") {

        when {
            params {
                input  = Fixtures.absolutise("$baseDir", "$outputDir")
                outdir = "$outputDir"
            }
        }

        then {
            // stable_path: All files + folders in ${params.outdir}/ with a stable path (including file name)
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_content: All files in ${params.outdir}/ with stable content
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            // Asserted by name rather than left to the snapshot alone: dropping a module's
            // `topic: versions` output drops its entry silently, and a refreshed snapshot would
            // then simply record the loss.
            def software_versions = path("$outputDir/pipeline_info/jacquard_software_mqc_versions.yml").text
            // Every section MultiQC built, in the order the report lays them out. Taken from
            // multiqc_data.json's insertion-ordered plot data rather than the rendered HTML; the
            // file as a whole is too volatile to snapshot, so only this list is read off it.
            def plot_sections = new groovy.json.JsonSlurper()
                .parseText(path("$outputDir/multiqc/multiqc_data/multiqc_data.json").text)
                .report_plot_data
                .keySet()
                .toList() // a keySet's own findAll returns a Set, which never equals a List
            def carmack_sections = plot_sections.findAll { section -> section.startsWith('carmack_') }

            assert workflow.success
            assertAll(
                // Asserted by name as well as snapshotted: at the default threshold both arms of
                // the fixture clear the gate, and a refreshed snapshot would record a loss quietly.
                { assert path("$outputDir/pipeline_info/arm_gate.tsv").readLines() == [
                    'sample\tarm\ttgidx\treads\tthreshold\tstatus',
                    'SK609\tscrna\tNONE\t6227\t1000\tPASS',
                    'SK609\tsctip\tTATAGCCT\t13051\t1000\tPASS',
                ] },
                // The fixture is built to exercise both arms, so this file listing exactly these
                // two tokens is what makes every downstream per-arm assertion meaningful. Its counts
                // are the gate's own, read off a second file: a distribution that drifted from the
                // detected set would show up as a disagreement here rather than as a quiet rewiring.
                { assert path("$outputDir/carmack/preparereads/SK609/SK609.detected_targets.txt").readLines() == [
                    'NONE\t6229',
                    'TATAGCCT\t13332',
                ] },
                { assert [
                    'CARMACK_EXTRACTBARCODES',
                    'CARMACK_EXTRACTUMIS',
                    'CARMACK_ASSIGNTARGETS',
                    'CARMACK_PREPAREREADS',
                ].every { process -> software_versions.contains("${process}:\n  carmack: ") } },
                { assert [
                    'CHEMISTRYADAPTERS',
                    'FASTP',
                    'STAR_GENOMEGENERATE',
                    'STAR_STARSOLO',
                    'BOWTIE2_BUILD',
                    'BOWTIE2_ALIGN',
                    'SAMTOOLS_SORT',
                    'SAMTOOLS_STATS',
                    'RESYNCBARCODES',
                    'TAGQNAME',
                    'UMITOOLS_DEDUP',
                ].every { process -> software_versions.contains("${process}:\n") } },
                // The counterpart of each arm test's "no aligner task was submitted": the same
                // predicates have to find the tasks here, or their emptiness there proves nothing.
                { assert workflow.trace.tasks().findAll { task -> task.name.contains('STAR_') }.size() == 2 },
                { assert workflow.trace.tasks().findAll { task -> task.name.contains('BOWTIE2_') }.size() == 2 },
                // Both arms publish under `<sample>.<tgidx>`, which is `meta.id` and nothing else.
                { assert path("$outputDir/umitools/SK609.TATAGCCT/SK609.TATAGCCT.bam").exists() },
                { assert path("$outputDir/samtools/SK609.TATAGCCT/SK609.TATAGCCT.stats").exists() },
                // Each arm's report rows, all named off meta.id alone: without them a MultiQC
                // report says nothing about read quality, mapping or duplication per target index.
                { assert path("$outputDir/multiqc/multiqc_data/multiqc_fastqc.txt").readLines().count { it.startsWith('SK609.none\t') } == 1 },
                { assert path("$outputDir/multiqc/multiqc_data/multiqc_star.txt").readLines().count { it.startsWith('SK609.none\t') } == 1 },
                { assert path("$outputDir/multiqc/multiqc_data/multiqc_fastqc.txt").readLines().count { it.startsWith('SK609.TATAGCCT_') } == 2 },
                { assert path("$outputDir/multiqc/multiqc_data/multiqc_fastp.txt").readLines().count { it.startsWith('SK609.TATAGCCT\t') } == 1 },
                { assert path("$outputDir/multiqc/multiqc_data/multiqc_bowtie2.txt").readLines().count { it.startsWith('SK609.TATAGCCT\t') } == 1 },
                { assert path("$outputDir/multiqc/multiqc_data/multiqc_samtools_stats.txt").readLines().count { it.startsWith('SK609.TATAGCCT\t') } == 1 },
                // umi_tools deduplicated per cell and MultiQC read its log: the row carries fewer
                // reads out than in, which is the one number a silently misconfigured dedup loses.
                // Both counts are higher than the same fixture reaches untrimmed (1016 in, 300 out):
                // bowtie2 maps end to end, so an adapter read-through costs the whole alignment.
                { assert path("$outputDir/multiqc/multiqc_data/multiqc_umitools_dedup.txt").readLines().findAll { it.startsWith('SK609.TATAGCCT\t') }.collect { row ->
                    def fields = row.split('\t')
                    [ fields[1] as int, fields[2] as int ]
                } == [ [ 1078, 410 ] ] },
                // Linear dedup's general-statistics payload builds no section of its own, so the
                // table is the only place it shows. Its columns have to land on the row umi_tools'
                // are already on: a sample name drifting by so much as a suffix would split the
                // arm across two rows and leave both halves looking merely sparse.
                { assert path("$outputDir/multiqc/multiqc_data/multiqc_general_stats.txt").readLines().with { lines ->
                    def columns = lines.first().split('\t', -1).toList()
                    def row = lines.find { line -> line.startsWith('SK609.TATAGCCT\t') }.split('\t', -1).toList()
                    [
                        'custom_content_carmack-pct_duplication',
                        'custom_content_carmack-pct_missing_as',
                        'umi_tools-dedup_percent_passing',
                    ].every { column -> columns.contains(column) && row[columns.indexOf(column)] }
                } },
                // All four read-preparation stages and linear dedup reach the report, under the one
                // `carmack_` parent, and in the order the reads pass through them rather than
                // alphabetically — which is what `report_section_order` in
                // assets/multiqc_config.yml buys. Linear dedup comes last because it runs last:
                // the whole `carmack_` parent is placed as a single block, so no entry can move
                // one of its sections down beside umi_tools', where the step itself belongs.
                { assert carmack_sections == [
                    'carmack_extraction_breakdown_plot',
                    'carmack_extraction_barcode_rank_plot',
                    'carmack_extraction_edit_distance_plot',
                    'carmack_umi_breakdown_plot',
                    'carmack_umi_anchor_run_plot',
                    'carmack_tgidx_breakdown_plot',
                    'carmack_tgidx_target_distribution_plot',
                    'carmack_tgidx_edit_distance_plot',
                    'carmack_tgidx_anchor_run_plot',
                    'carmack_prepare_target_distribution_plot',
                    'carmack_linear_dedup_breakdown_plot',
                    'carmack_linear_dedup_chromosome_breakdown_plot',
                ] },
                // Trimming renders between read preparation and the gate it re-runs, rather than
                // at the end among the other tool sections, which is what the `fastp` entry in
                // `report_section_order` buys.
                { assert plot_sections.findIndexOf { section -> section.startsWith('fastp') } > plot_sections.findLastIndexOf { section -> section.startsWith('carmack_') } },
                { assert plot_sections.findIndexOf { section -> section.startsWith('fastp') } < plot_sections.indexOf('arm_gate_table') },
                // Each of those sections was parsed, not merely ordered: MultiQC wrote a data file
                // for every one of them.
                { assert carmack_sections.every { section -> path("$outputDir/multiqc/multiqc_data/multiqc_${section}.txt").exists() } },
                // The bargraph carries the scRNA arm as a category of its own, so the chart accounts
                // for every read the run saw rather than for the target-matched share alone.
                { assert path("$outputDir/multiqc/multiqc_data/multiqc_carmack_prepare_target_distribution_plot.txt").readLines() == [
                    'Sample\tTATAGCCT\tNONE',
                    'SK609\t13332\t6229',
                ] },
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/jacquard_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    stable_path,
                    // All files with stable contents
                    stable_content
                ).match() }
            )
        }
    }
}
