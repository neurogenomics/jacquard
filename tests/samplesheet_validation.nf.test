nextflow_pipeline {

    name "Test samplesheet validation"
    script "../main.nf"
    tag "pipeline"

    test("rejects a row with an empty fastq_2 before submitting any process") {

        when {
            params {
                input  = "$baseDir/tests/data/samplesheet_missing_r2.csv"
                outdir = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.trace.tasks().size() == 0 },
                { assert workflow.stderr.join("\n").contains("Missing required field(s): fastq_2") }
            )
        }
    }

    test("rejects the same fastq_1 listed twice under one sample") {

        when {
            params {
                input  = Fixtures.absolutise("$baseDir", "$outputDir", 'samplesheet_duplicate_row.csv')
                outdir = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.trace.tasks().size() == 0 },
                // A sample may span rows, one per lane, so uniqueness is on the pair of columns: the
                // rejected sheet would otherwise concatenate one lane with itself and double every
                // read count the run reports. The path the message quotes is the checkout's own.
                { assert workflow.stderr.join("\n").contains("Detected duplicate entries: [sample:SK609, fastq_1:") }
            )
        }
    }
}
