/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Placeholder. jacquard has no published full-size dataset yet, so this profile is registered —
    nf-core tooling and the release workflow both expect it to exist — but deliberately cannot run.

    The `input` path below does not exist, so `-profile test_full` stops in parameter validation
    naming this file rather than starting a run that would fail later for a reason of its own. Give
    it a real samplesheet of paired-end libraries when one is published.

    Use `-profile test` for the working test dataset.

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile (placeholder)'
    config_profile_description = 'Not runnable: jacquard has no full-size test dataset yet'

    input = "${projectDir}/conf/NO_FULL_SIZE_DATASET_YET.csv"
}
