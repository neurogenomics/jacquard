/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: FASTQC {
        ext.args = '--quiet'
    }

    withName: 'CARMACK_EXTRACTBARCODES' {
        ext.args   = { params.carmack_fast ? '--fast' : '' }
        publishDir = [
            path: { "${params.outdir}/carmack/extractbarcodes/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'CARMACK_EXTRACTUMIS' {
        publishDir = [
            path: { "${params.outdir}/carmack/extractumis/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'CARMACK_ASSIGNTARGETS' {
        publishDir = [
            path: { "${params.outdir}/carmack/assigntargets/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'CARMACK_PREPAREREADS' {
        publishDir = [
            path: { "${params.outdir}/carmack/preparereads/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }

    // The FASTA is what the run trimmed against, so it is published rather than left in the work
    // directory: an adapter set that changed with the chemistry is otherwise invisible afterwards.
    withName: 'CHEMISTRYADAPTERS' {
        publishDir = [
            path: { "${params.outdir}/fastp" },
            mode: params.publish_dir_mode
        ]
    }

    // Nextflow full-regex-matches a colon-bearing selector against the whole qualified process
    // name, so the partial path `SCTIP_ARM:FASTP` matches nothing, warns, and leaves fastp on stock
    // defaults while the run exits 0. A bare `withName: 'FASTP'` would instead reach the scRNA arm,
    // which needs different arguments. The leading `.*` carries no colon of its own because the
    // qualified name is `JACQUARD:SCTIP_ARM:FASTP` in a run and `SCTIP_ARM:FASTP` under an nf-test
    // that instantiates the subworkflow directly: `.*:` would match the first and not the second,
    // so the arguments this block exists to set would be untested.
    //
    // No `--cut_right` or `--cut_tail`: quality trimming shortens reads, which moves the leftmost
    // coordinate of a reverse-strand alignment — the key `umitools dedup` groups on. fastp's
    // defaults filter on quality rather than trim it, so this is only a hazard if someone adds it.
    //
    // No `--umi` either: it appends to the read name, and carmack's `UR=<umi>` field is read back
    // out of that name by TAGQNAME, so the UMI would silently parse as `<umi>_<appended>`.
    //
    // `--detect_adapter_for_pe` is not set here and cannot be unset: the vendored module hardcodes
    // it for paired input. Measured against fastp 1.3.6 and this chemistry's FASTA it costs 2 read
    // pairs of 13,332 and detects the Nextera transposase adapter the FASTA already carries.
    //
    // fastp's overlap trimming shortens R2 more than it should on both arms, and is left on because
    // switching it off costs more than the shortening does. When R2 reads past the start of R1,
    // fastp cuts both mates to the overlap length, which is only the insert length when R1 also
    // spans the whole fragment. carmack has already cut R1 down to the insert's first bases, so an
    // insert longer than R1 but shorter than R2 leaves R2 cut to R1's length. On SK588_4 this
    // removes genuine insert from 13.6% of scTIP pairs and 9.2% of scRNA pairs, and on SK680_1 from
    // 6.6% of scTIP pairs. Cutting R2 at the fragment start instead changed MAPQ ≥ 30 proper-pair
    // records by -0.4% (SK588_4) and -0.1% (SK680_1) on the scTIP arm, and UMIs in cells by +0.7%
    // on the scRNA arm. Switching overlap analysis off (`--overlap_len_require` above any R1
    // length), so that read-through is cut only at an adapter sequence, keeps the full insert but
    // lowered MAPQ ≥ 30 proper-pair records by 1.3% on SK588_4: bowtie2 aligns end to end, and the
    // longer R2 carries more of its error-prone 3' end. R2's 5' end, which fixes the fragment's
    // coordinates, is never touched. The same misreading is why the report leaves out fastp's
    // insert-size plot; `assets/multiqc_config.yml` explains it.
    //
    // fastp's default quality filter stays on. On 2M SK588_4 pairs, `--disable_quality_filtering`
    // let 1.06% more pairs reach bowtie2 but added only 0.31% MAPQ ≥ 30 proper-pair records, and
    // raised the mean mismatch count of what was kept from 0.216 to 0.224: the pairs it filters are
    // mostly ones that would not have placed.
    withName: '.*SCTIP_ARM:FASTP' {
        ext.args   = [
            // Explicit rather than left to fastp's two-colour instrument auto-detection, which
            // depends on carmack continuing to preserve the instrument prefix in the read name.
            '--trim_poly_g',
            // 20 is the lowest R1 length measured: an R1 cut to 20 bases aligns within 0.1-0.32
            // points of a full-length one, and below that the floor is untested. On 2M SK588_4
            // pairs, lowering it from 25 let 0.72% more pairs through and raised MAPQ ≥ 30
            // proper-pair records by 0.59%, with the mean mismatch count of what was kept
            // unchanged.
            '--length_required 20',
        ].join(' ')
        publishDir = [
            path: { "${params.outdir}/fastp/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.{json,html,log}'
        ]
    }

    // Same selector form, the same `--cut_right`/`--cut_tail`/`--umi` hazards and the same overlap
    // trimming of R2 as the scTIP block above: STARsolo reads the barcode and the UMI off fixed
    // offsets of a separate file, which RESYNCBARCODES pairs to this arm's output by read name.
    //
    // Trim-only on purpose. STAR soft-clips what it cannot align, so this arm trims to stop adapter
    // read-through from displacing the cDNA, not to raise its quality: a read fastp discards here
    // is a cell STARsolo never counts, and the barcode that names the cell lives in the other file
    // and is never the read being judged.
    //
    // No adapter sequences either — this arm is left on fastp's overlap analysis alone. On
    // SK588_4's pairs whose R1 carries no barcode-ladder sequence, cutting read-through at an
    // adapter instead (Tn5 ME on R1, PRIMER_A's reverse complement on R2, overlap analysis off)
    // lowered GeneFull UMIs in cells by 6.6%. On the whole arm (7.11M pairs), trimming the ME from
    // both mates on top of overlap analysis changed them by -0.15%. The chemistry FASTA the scTIP
    // arm uses is no alternative: it matches PRIMER_A at the start of R1s that are
    // template-switch-oligo concatemer rather than cDNA and deletes them, dropping 2.6M of those
    // 7.11M pairs, so whatever it does to real cDNA cannot be read off a run that includes them.
    withName: '.*SCRNA_ARM:FASTP' {
        ext.args   = [
            // Quality filtering discards a whole pair; the arm keeps every read it can still place.
            '--disable_quality_filtering',
            // Not `--disable_length_filtering`: a read adapter trimming consumed entirely would
            // otherwise reach STAR as a zero-length record.
            '--length_required 1',
        ].join(' ')
        publishDir = [
            path: { "${params.outdir}/fastp/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.{json,html,log}'
        ]
    }

    // The resynced barcode read is an intermediate: it is carmack's own records, less the ones
    // whose cDNA read trimming dropped.
    withName: 'RESYNCBARCODES' {
        publishDir = [ enabled: false ]
    }

    withName: 'FASTQC_PREPARED' {
        ext.args   = '--quiet'
        publishDir = [
            path: { "${params.outdir}/fastqc/prepared/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }

    // --genomeSAindexNbases is deliberately absent: the module derives it from the FASTA's own
    // length, which is what a small reference such as a single chromosome needs and what a whole
    // genome needs too, so pinning a value here would be right for one and wrong for the other.
    withName: 'STAR_GENOMEGENERATE' {
        publishDir = [ enabled: false ]
    }

    // The barcode read carmack synthesizes is one fixed 38 base record: the three 10 base barcode
    // chunks the chemistry declares, joined in read-structure order, then the 8 base UMI. Spelling
    // that out rather than leaving STARsolo on its 10x defaults (16 + 10) is what makes the cell
    // barcode and UMI it reads the same ones the scTIP arm carries in its headers.
    //
    // STAR's alignment floor stays at its default: a pair is placed only if its score and matched
    // bases reach 0.66 of both mates' length. On SK588_4's paired arm, lowering it to 0.5 and 0.33
    // raised UMIs in cells by 6.3% and 11.2%, but the pairs 0.33 adds are 70% one mate placed, 27%
    // soft-clipped and carry 5.5x the mismatch rate. Most of the pairs the floor rejects have an R1
    // that is template-switch-oligo concatemer rather than cDNA, which is not expected to align.
    withName: 'STAR_STARSOLO' {
        ext.args = { [
            '--soloCBstart 1',
            '--soloCBlen 30',
            '--soloUMIstart 31',
            '--soloUMIlen 8',
            // The library is forward-stranded: the cDNA R1 is the sense read. Read 1 of uniquely
            // mapped proper pairs lies on its exon's own strand in 77.8-94.7% of reads across 11
            // carmack libraries, where a dUTP control run the same way reads 7.3%. `Unstranded`
            // assigns more reads (GeneFull 33.2% against 24.2% on SK588_4's R1), but the extra
            // share is antisense to the gene it lands in, and mostly intronic, which is where
            // unstranded genomic-DNA background falls. In paired mode STAR takes a pair's strand
            // from mate 1, which is R1. Set explicitly, although it is STAR's default, because the
            // value is a property of the chemistry and not a default to inherit.
            '--soloStrand Forward',
            // `Gene` is always requested alongside whatever --solo_features asks for, because the
            // module's `summary` output is a non-optional `*/Gene/Summary.csv`: a run counting only
            // pre-mRNA would leave no `Gene/` directory behind and fail the task on a missing file.
            "--soloFeatures ${(['Gene'] + params.solo_features.tokenize()).unique().join(' ')}",
            "--soloMultiMappers ${params.solo_multimappers}",
            // STARsolo writes the corrected `CB`/`UB` tags only into a BAM it coordinate-sorts
            // itself; an unsorted BAM sorted afterwards would carry the raw `CR`/`UR` alone. The
            // sort buffer is half the task's memory, leaving the other half for the genome.
            params.solo_bam
                ? "--outSAMtype BAM SortedByCoordinate --outSAMattributes NH HI nM AS CR UR CB UB GX GN sS sQ sM" +
                    (task.memory ? " --limitBAMsortRAM ${task.memory.toBytes().intdiv(2)}" : '')
                : '--outSAMtype None',
        ].join(' ') }
        publishDir = [
            path: { "${params.outdir}/star/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'SAMTOOLS_INDEX_SOLO' {
        publishDir = [
            path: { "${params.outdir}/star/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }

    // The bowtie2 index is an intermediate of the run, not a result of it.
    withName: 'BOWTIE2_BUILD' {
        publishDir = [ enabled: false ]
    }

    // Only the alignment summary is published: the unsorted BAM is superseded twice over before
    // the arm is finished, and MultiQC reads its bowtie2 row out of this log.
    //
    // Set explicitly because the arm otherwise runs on bowtie2's stock defaults, which are tuned
    // for whole-genome paired libraries rather than for a Tn5 insert flanked by a barcode ladder.
    //
    // `--no-mixed --no-discordant` is structural rather than a preference. Everything downstream
    // consumes a fragment, not a read: `umitools dedup --paired` keys on both mate ends, and the
    // scTIP arm's product is the Tn5 insert the pair spans. A single-mate or discordant alignment
    // has no span to contribute, so admitting one only adds a record that later stages must
    // re-exclude — bowtie2's default admits both.
    //
    // `-X 2000` against a default of 500: on SK588_4 the aligned insert distribution has a mean of
    // 258 and an sd of 140, and 5.70% of pairs still sit above 500. A cap 1.7 sd above the mean
    // truncates the right tail of a Tn5 library rather than bounding it.
    //
    // `--very-sensitive` trades wall-clock for seed sensitivity, which is what a short insert
    // needs: the scTIP cDNA read reaching the aligner averages 34 bases after trimming, leaving
    // little room for the default preset's longer seed (22 bases against 20) and wider seed
    // interval to find a genomic match. It is pinned rather than left to the default so that
    // alignment rates stay comparable between pipeline versions.
    //
    // args2 reaches the `samtools view` bowtie2 pipes into. `-F 780` drops unmapped, mate-unmapped,
    // secondary and QC-failed records, `-f 2` keeps only proper pairs, and `-q` applies
    // `--min_mapq`. Without this the published BAM carries every record bowtie2 emitted, including
    // the unaligned ones, and the multi-mapper share reaches deduplication.
    withName: 'BOWTIE2_ALIGN' {
        ext.args  = [
            '--very-sensitive',
            '--no-mixed',
            '--no-discordant',
            '-X 2000',
            // Multithreaded bowtie2 writes records in whatever order its threads finish: five runs
            // at 4 threads on the SK609 fixture gave four different orders. The coordinate sort
            // keeps that order among records at one position, and deduplication keeps one of each
            // such group, so without this the surviving duplicate, and every statistic of the
            // final BAM, changes from run to run. `--reorder` restores input order at any thread
            // count.
            '--reorder',
        ].join(' ')
        // `-q` tests each record's own MAPQ, which could split a pair if its mates differed. They
        // do not here: across 1M concordant SK588_4 pairs, bowtie2 gave both mates the same MAPQ in
        // every pair, so the filter keeps or drops whole fragments.
        ext.args2 = "-q ${params.min_mapq} -f 2 -F 780"
        publishDir = [
            path: { "${params.outdir}/bowtie2/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.log'
        ]
    }

    // The sort and the retagging both rewrite the same alignments, so neither output is published.
    // `.sorted` is not forced by anything — samtools/sort stages its input as `?/*`, so its own
    // input/output name guard can never fire — and is kept so that three otherwise identically
    // named BAMs in adjacent work directories can be told apart while debugging.
    withName: 'SAMTOOLS_SORT' {
        ext.prefix = { "${meta.id}.sorted" }
        publishDir = [ enabled: false ]
    }

    // `.tagged`, by contrast, is forced: umitools/dedup stages its input under its own name and
    // aborts when that equals its output, and dedup is the step whose output has to be `meta.id`.
    withName: 'TAGQNAME' {
        ext.prefix = { "${meta.id}.tagged" }
        publishDir = [ enabled: false ]
    }

    withName: 'SAMTOOLS_INDEX_TAGGED' {
        publishDir = [ enabled: false ]
    }

    // Deduplication is per cell and keyed on the tags TAGQNAME wrote, never on the read name:
    // umi_tools validates no UMI character, so pointing it at the raw QNAME would drag the literal
    // `CB=` and `UR=` strings into every statistic it reports.
    withName: 'UMITOOLS_DEDUP' {
        ext.args = [
            '--per-cell',
            '--extract-umi-method=tag',
            '--umi-tag=UB',
            '--cell-tag=CB',
        ].join(' ')
        publishDir = [
            path: { "${params.outdir}/umitools/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'SAMTOOLS_INDEX_DEDUP' {
        publishDir = [
            path: { "${params.outdir}/umitools/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }

    // Selector written without a colon after `.*`, as on the fastp blocks above, so it matches both
    // the qualified name a run builds and the shorter one an nf-test of the subworkflow builds.
    // Published under its own directory rather than the default `carmack/`: this is the arm's final
    // BAM, not one of the read-preparation outputs the other carmack modules write.
    withName: '.*SCTIP_ARM:CARMACK_LINEARDEDUP' {
        publishDir = [
            path: { "${params.outdir}/lineardedup/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'SAMTOOLS_STATS' {
        publishDir = [
            path: { "${params.outdir}/samtools/${meta.id}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

}
