graph LR
    subgraph input[Input]
        input_in[ ]
    end

    subgraph readprep[Pre-processing]
        fastqc_raw[FastQC]
        extract_barcodes[carmack extract-barcodes]
        extract_umis[carmack extract-umis]
        assign_targets[carmack assign-targets]
        prepare_reads[carmack prepare-reads]
        prep_out[ ]
        arm_gate[Read-count gate]
        gate_out[ ]
        fastqc_raw -->|prep,qc| extract_barcodes
        extract_barcodes -->|prep,qc| extract_umis
        extract_umis -->|prep,qc| assign_targets
        assign_targets -->|prep,qc| prepare_reads
        prepare_reads -->|prep| prep_out
        prepare_reads -->|prep| arm_gate
        arm_gate -->|qc| gate_out
    end

    subgraph scrna_arm[scRNA arm]
        fastp_scrna[fastp]
        fastqc_scrna[FastQC]
        resync_barcodes[Resync barcodes]
        star_fasta[ ]
        star_gtf[ ]
        star_index[STAR genomeGenerate]
        star_align[STARsolo]
        solo_out[ ]
        fastp_scrna -->|scrna| fastqc_scrna
        fastqc_scrna -->|scrna| resync_barcodes
        resync_barcodes -->|scrna| star_align
        star_fasta -->|scrna| star_index
        star_gtf -->|scrna| star_index
        star_index -->|scrna| star_align
        star_align -->|scrna| solo_out
    end

    subgraph sctip_arm[scTIP arms]
        fastp_sctip[fastp]
        fastqc_sctip[FastQC]
        bt2_fasta[ ]
        bt2_build[bowtie2-build]
        bt2_align[bowtie2]
        tagqname[QNAME → CB/UB tags]
        umi_dedup[umi_tools dedup]
        sctip_stats[samtools stats]
        dedup_out[ ]
        fastp_sctip -->|sctip| fastqc_sctip
        fastqc_sctip -->|sctip| bt2_align
        bt2_fasta -->|sctip| bt2_build
        bt2_build -->|sctip| bt2_align
        bt2_align -->|sctip| tagqname
        tagqname -->|sctip| umi_dedup
        umi_dedup -->|sctip| sctip_stats
        umi_dedup -->|sctip| dedup_out
    end

    subgraph reporting[Reporting]
        multiqc[MultiQC]
        report_out[ ]
        multiqc -->|qc| report_out
    end

    input_in -->|prep,qc| fastqc_raw
    prepare_reads -->|qc| multiqc
    arm_gate -->|scrna| fastp_scrna
    arm_gate -->|sctip| fastp_sctip
    star_align -->|qc| multiqc
    sctip_stats -->|qc| multiqc
