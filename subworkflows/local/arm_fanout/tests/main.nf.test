nextflow_workflow {

    name "Test subworkflow ARM_FANOUT"
    script "../main.nf"
    workflow "ARM_FANOUT"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "carmack"
    tag "arm_fanout"

    test("SK609 - both arms clear the default threshold") {

        tag "arm_fanout_both"

        setup {
            run("CARMACK_READPREP") {
                script "../../carmack_readprep/main.nf"
                workflow {
                    """
                    input[0] = channel.of([
                        [ id:'SK609' ],
                        [
                            file("${baseDir}/tests/data/SK609_L5_R1.fastq.gz", checkIfExists: true),
                            file("${baseDir}/tests/data/SK609_L5_R2.fastq.gz", checkIfExists: true),
                        ],
                    ])
                    input[1] = 'carmack_custom_seq_1_0'
                    // Read preparation is setup here, not the thing under test, so it is given every stage.
                    input[2] = [ 'barcodes', 'umis', 'targets', 'readprep', 'gate', 'arms' ]
                    """
                }
            }
        }

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = CARMACK_READPREP.out.scrna
                input[1] = CARMACK_READPREP.out.sctip
                input[2] = CARMACK_READPREP.out.stats_json
                input[3] = 1000
                """
            }
        }

        then {
            // Asserted as literals rather than snapshotted: meta.id is what every downstream module
            // names its files and its MultiQC row after, so a drifted key has to fail here.
            def scrna_meta = [ id:'SK609.none', sample:'SK609', arm:'scrna', tgidx:'NONE', single_end:false ]
            def sctip_meta = [ id:'SK609.TATAGCCT', sample:'SK609', arm:'sctip', tgidx:'TATAGCCT', single_end:false ]

            assertAll(
                { assert workflow.success },
                { assert workflow.out.scrna.size() == 1 },
                { assert workflow.out.sctip.size() == 1 },
                { assert workflow.out.scrna[0][0] == scrna_meta },
                { assert workflow.out.sctip[0][0] == sctip_meta },
                // The counts are carmack's own, measured off this fixture; the gate and the arms it
                // feeds both come from them, so a disagreement is a wiring fault.
                { assert workflow.out.gate.find { it[0].tgidx == 'NONE' } == [ scrna_meta, 6229, 'PASS' ] },
                { assert workflow.out.gate.find { it[0].tgidx == 'TATAGCCT' } == [ sctip_meta, 13332, 'PASS' ] },
                { assert workflow.out.scrna[0][1..3].collect { file(it).name } == [
                    'SK609.none.r1.fastq.gz',
                    'SK609.none.r2.fastq.gz',
                    'SK609.none.barcodes.fastq.gz',
                ] },
                { assert workflow.out.sctip[0][1].collect { file(it).name } == [
                    'SK609.TATAGCCT.r1.fastq.gz',
                    'SK609.TATAGCCT.r2.fastq.gz',
                ] },
                // Asserted absent, not merely unasserted: a `contains` check cannot catch a warning
                // that fires when it should not, and SK609 carries a target arm.
                { assert !Fixtures.warnings("$workDir").any { warning -> warning.contains('pure scRNA run') } }
            )
        }
    }

    test("SK609 - min_arm_reads 8000 drops the scRNA arm alone") {

        tag "arm_fanout_8000"

        setup {
            run("CARMACK_READPREP") {
                script "../../carmack_readprep/main.nf"
                workflow {
                    """
                    input[0] = channel.of([
                        [ id:'SK609' ],
                        [
                            file("${baseDir}/tests/data/SK609_L5_R1.fastq.gz", checkIfExists: true),
                            file("${baseDir}/tests/data/SK609_L5_R2.fastq.gz", checkIfExists: true),
                        ],
                    ])
                    input[1] = 'carmack_custom_seq_1_0'
                    input[2] = [ 'barcodes', 'umis', 'targets', 'readprep', 'gate', 'arms' ]
                    """
                }
            }
        }

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = CARMACK_READPREP.out.scrna
                input[1] = CARMACK_READPREP.out.sctip
                input[2] = CARMACK_READPREP.out.stats_json
                input[3] = 8000
                """
            }
        }

        then {
            assertAll(
                // A tripped gate never aborts: the failing arm is dropped and the run finishes.
                { assert workflow.success },
                { assert workflow.out.scrna.size() == 0 },
                { assert workflow.out.sctip.size() == 1 },
                { assert workflow.out.sctip[0][0].id == 'SK609.TATAGCCT' },
                { assert workflow.out.gate.find { it[0].tgidx == 'NONE' }[1..2] == [ 6229, 'FAIL' ] },
                { assert workflow.out.gate.find { it[0].tgidx == 'TATAGCCT' }[1..2] == [ 13332, 'PASS' ] },
                { assert Fixtures.warnings("$workDir").contains("Arm 'SK609.none' carries 6229 read(s), below --min_arm_reads 8000; it is dropped and the run continues.") }
            )
        }
    }

    test("SK609 - min_arm_reads 20000 drops every arm of the sample") {

        tag "arm_fanout_20000"

        setup {
            run("CARMACK_READPREP") {
                script "../../carmack_readprep/main.nf"
                workflow {
                    """
                    input[0] = channel.of([
                        [ id:'SK609' ],
                        [
                            file("${baseDir}/tests/data/SK609_L5_R1.fastq.gz", checkIfExists: true),
                            file("${baseDir}/tests/data/SK609_L5_R2.fastq.gz", checkIfExists: true),
                        ],
                    ])
                    input[1] = 'carmack_custom_seq_1_0'
                    input[2] = [ 'barcodes', 'umis', 'targets', 'readprep', 'gate', 'arms' ]
                    """
                }
            }
        }

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = CARMACK_READPREP.out.scrna
                input[1] = CARMACK_READPREP.out.sctip
                input[2] = CARMACK_READPREP.out.stats_json
                input[3] = 20000
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.scrna.size() == 0 },
                { assert workflow.out.sctip.size() == 0 },
                // The verdict survives the sample it dropped, so the run record is still complete.
                { assert workflow.out.gate.size() == 2 },
                { assert workflow.out.gate.every { it[2] == 'FAIL' } }
            )
        }
    }

    test("SK609 and SK609SCRNA - a sample losing every arm leaves the other sample untouched") {

        tag "arm_fanout_multi_sample"

        setup {
            run("CARMACK_READPREP") {
                script "../../carmack_readprep/main.nf"
                workflow {
                    """
                    // Two libraries that fail the same threshold differently: SK609 loses one of two
                    // arms, SK609SCRNA loses the only arm it has.
                    input[0] = channel.of(
                        [
                            [ id:'SK609' ],
                            [
                                file("${baseDir}/tests/data/SK609_L5_R1.fastq.gz", checkIfExists: true),
                                file("${baseDir}/tests/data/SK609_L5_R2.fastq.gz", checkIfExists: true),
                            ],
                        ],
                        [
                            [ id:'SK609SCRNA' ],
                            [
                                file("${baseDir}/tests/data/SK609_scrna_L5_R1.fastq.gz", checkIfExists: true),
                                file("${baseDir}/tests/data/SK609_scrna_L5_R2.fastq.gz", checkIfExists: true),
                            ],
                        ],
                    )
                    input[1] = 'carmack_custom_seq_1_0'
                    input[2] = [ 'barcodes', 'umis', 'targets', 'readprep', 'gate', 'arms' ]
                    """
                }
            }
        }

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = CARMACK_READPREP.out.scrna
                input[1] = CARMACK_READPREP.out.sctip
                input[2] = CARMACK_READPREP.out.stats_json
                input[3] = 8000
                """
            }
        }

        then {
            def countReads = { String fastq_gz ->
                def lines = 0
                new java.util.zip.GZIPInputStream(new File(fastq_gz).newInputStream()).withReader('UTF-8') { reader ->
                    while (reader.readLine() != null) {
                        lines++
                    }
                }
                lines.intdiv(4)
            }
            def warnings = Fixtures.warnings("$workDir")

            assertAll(
                // SK609SCRNA loses every arm it has. The run must still finish, and finish with
                // SK609's surviving arm intact — one bad library cannot cost a run its other work.
                { assert workflow.success },
                { assert workflow.out.sctip.size() == 1 },
                { assert workflow.out.sctip[0][0] == [ id:'SK609.TATAGCCT', sample:'SK609', arm:'sctip', tgidx:'TATAGCCT', single_end:false ] },
                { assert workflow.out.sctip[0][1].collect { file(it).name } == [
                    'SK609.TATAGCCT.r1.fastq.gz',
                    'SK609.TATAGCCT.r2.fastq.gz',
                ] },
                // Counted out of the files the surviving arm actually carries: an arm delivered
                // short, or built from the wrong sample's reads, would still be one tuple here.
                { assert workflow.out.sctip[0][1].collect { countReads(it.toString()) } == [ 13332, 13332 ] },
                // Both scRNA arms are below the threshold, from either sample.
                { assert workflow.out.scrna.size() == 0 },
                // SK609SCRNA reaches no arm channel at all, under any arm.
                { assert workflow.out.sctip.every { it[0].sample != 'SK609SCRNA' } },
                { assert workflow.out.gate.findAll { it[0].sample == 'SK609SCRNA' }.collect { it[2] } == [ 'FAIL' ] },
                // The verdict covers every candidate arm of both samples, dropped or not.
                { assert workflow.out.gate.collect { [ it[0].sample, it[0].tgidx, it[1], it[2] ] }.toSorted() == [
                    [ 'SK609', 'NONE', 6229, 'FAIL' ],
                    [ 'SK609', 'TATAGCCT', 13332, 'PASS' ],
                    [ 'SK609SCRNA', 'NONE', 2000, 'FAIL' ],
                ] },
                { assert warnings.contains("Arm 'SK609SCRNA.none' carries 2000 read(s), below --min_arm_reads 8000; it is dropped and the run continues.") }
            )
        }
    }

    test("SK609SCRNA - a detected set of NONE alone warns and proceeds") {

        tag "arm_fanout_scrna_only"

        setup {
            run("CARMACK_READPREP") {
                script "../../carmack_readprep/main.nf"
                workflow {
                    """
                    // The 2000 fixture pairs carmack itself assigned to the scRNA arm, so the
                    // library genuinely carries no target index rather than being made to look so.
                    input[0] = channel.of([
                        [ id:'SK609SCRNA' ],
                        [
                            file("${baseDir}/tests/data/SK609_scrna_L5_R1.fastq.gz", checkIfExists: true),
                            file("${baseDir}/tests/data/SK609_scrna_L5_R2.fastq.gz", checkIfExists: true),
                        ],
                    ])
                    input[1] = 'carmack_custom_seq_1_0'
                    input[2] = [ 'barcodes', 'umis', 'targets', 'readprep', 'gate', 'arms' ]
                    """
                }
            }
        }

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = CARMACK_READPREP.out.scrna
                input[1] = CARMACK_READPREP.out.sctip
                input[2] = CARMACK_READPREP.out.stats_json
                input[3] = 1000
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.scrna.size() == 1 },
                { assert workflow.out.scrna[0][0].id == 'SK609SCRNA.none' },
                { assert workflow.out.sctip.size() == 0 },
                { assert workflow.out.gate.collect { [ it[0].tgidx, it[1], it[2] ] } == [ [ 'NONE', 2000, 'PASS' ] ] },
                { assert Fixtures.warnings("$workDir").contains("Sample 'SK609SCRNA': prepare-reads assigned no read to a target index, so this is a pure scRNA run.") }
            )
        }
    }

    test("SK609 - a passing arm whose bucket files are missing fails the run") {

        tag "arm_fanout_missing_bucket"

        setup {
            run("CARMACK_READPREP") {
                script "../../carmack_readprep/main.nf"
                workflow {
                    """
                    input[0] = channel.of([
                        [ id:'SK609' ],
                        [
                            file("${baseDir}/tests/data/SK609_L5_R1.fastq.gz", checkIfExists: true),
                            file("${baseDir}/tests/data/SK609_L5_R2.fastq.gz", checkIfExists: true),
                        ],
                    ])
                    input[1] = 'carmack_custom_seq_1_0'
                    input[2] = [ 'barcodes', 'umis', 'targets', 'readprep', 'gate', 'arms' ]
                    """
                }
            }
        }

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = CARMACK_READPREP.out.scrna
                // The bucket files are emptied on the way in, standing in for a carmack release that
                // renames them past the pattern this subworkflow matches on. The target distribution
                // is untouched, so TATAGCCT is still detected and still recorded PASS — which is the
                // state that used to leave the arm silently unprocessed and the run exiting 0.
                input[1] = CARMACK_READPREP.out.sctip.map { meta, _fastqs -> [ meta, [] ] }
                input[2] = CARMACK_READPREP.out.stats_json
                input[3] = 1000
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.stdout.join('\n').contains("Arm 'SK609.TATAGCCT' cleared the gate, but prepare-reads left no read pair named for target index 'TATAGCCT' of sample 'SK609'.") }
            )
        }
    }
}
